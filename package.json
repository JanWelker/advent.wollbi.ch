{
  "name": "advent-wollbi-ch",
  "version": "1.0.0",
  "description": "Wollbi-Fescht — Payload CMS on Next.js",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "start": "NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@react-pdf/renderer": "4.9.0",
    "graphql": "^16.11.0",
    "next": "16.4.4",
    "payload": "3.92.1",
    "payload-oauth2": "1.0.21",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "sharp": true
  },
  "overrides": {
    "undici": "8.12.3",
    "source-map-js": "1.2.2",
    "happy-dom": "21.0.4"
  }
}
