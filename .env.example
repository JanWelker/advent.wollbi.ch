# CloudNativePG writes this whole string; see JanWelker/homelab-apps.
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/advent
PAYLOAD_SECRET=change-me
# Where the site is served, used for absolute URLs and the admin CSRF list.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Authenticates the POST to the seed route.
SEED_TOKEN=change-me
# The Authentik client editors sign in with. Without both, the admin has no
# login at all; the redirect URI is NEXT_PUBLIC_SERVER_URL/api/users/oauth/callback.
AUTHENTIK_URL=https://auth.k8s.wlkr.ch
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
