# CloudNativePG writes this whole string; see JanWelker/homelab-apps.
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/advent
PAYLOAD_SECRET=change-me
# Where the site is served, used for absolute URLs and the admin CSRF list.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Only read by the seed route, and only on an empty database.
SEED_ADMIN_EMAIL=advent@wollbi.ch
SEED_ADMIN_PASSWORD=change-me
